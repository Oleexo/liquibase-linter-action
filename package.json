{
    "name": "liquibase-linter-action",
    "version": "1.0.0",
    "description": "GitHub Action for running liquibase-linter on Liquibase changelogs",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc && ncc build lib/main.js --source-map --license licenses.txt",
        "format": "prettier --write '**/*.ts'",
        "format-check": "prettier --check '**/*.ts'",
        "lint": "eslint src/**/*.ts",
        "package": "ncc build lib/main.js --source-map --license licenses.txt",
        "test": "jest",
        "all": "npm run build && npm run format && npm run lint && npm run package"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/n2jsoft-public-org/liquibase-linter-action.git"
    },
    "keywords": [
        "actions",
        "liquibase",
        "linter",
        "security",
        "database"
    ],
    "author": "n2jsoft",
    "license": "MIT",
    "dependencies": {
        "@actions/core": "^1.10.1",
        "@actions/exec": "^1.1.1",
        "@actions/github": "^6.0.0",
        "@actions/http-client": "^2.2.0",
        "@actions/tool-cache": "^2.0.1"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@typescript-eslint/eslint-plugin": "^6.19.0",
        "@typescript-eslint/parser": "^6.19.0",
        "@vercel/ncc": "^0.38.1",
        "eslint": "^8.56.0",
        "eslint-plugin-github": "^4.10.1",
        "eslint-plugin-jest": "^27.6.3",
        "jest": "^29.7.0",
        "prettier": "^3.2.4",
        "ts-jest": "^29.1.2",
        "typescript": "^5.3.3"
    }
}